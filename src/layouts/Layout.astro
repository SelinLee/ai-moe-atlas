---
import '../styles/global.css';
import { t, locales, htmlLang, languageNames, type Locale } from '../lib/i18n';
import { path, repo } from '../lib/paths';
import { navigation } from '../lib/navigation';
const { lang, title, description, active = 'atlas', route = '' } = Astro.props as {lang: Locale;title: string;description?: string;active?: string;route?: string};
const s = t(lang);
const pageURL = new URL(path(`${lang}/${route}`), Astro.site);
const coverId = route.startsWith('characters/') ? route.split('/')[1] : 'index';
const imageURL = new URL(path(`og/${lang}/${coverId}.png`), Astro.site);
const n = navigation[lang];
const nav = [{key:'atlas',url:'',label:n.home},{key:'resources',url:'collection/',label:n.directory},{key:'assets',url:'assets/',label:n.downloads}];
const section = ['references/', 'chibi/', 'models/'].includes(route) ? 'resources' : active;
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title} · {s.brand}</title><meta name="description" content={description ?? s.intro}/>
    <meta name="theme-color" content="#166b50"/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/>
    <link rel="canonical" href={pageURL}/>
    {locales.map(l => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(path(`${l}/${route}`), Astro.site)}/>)}
    <meta property="og:title" content={`${title} · ${s.brand}`}/><meta property="og:description" content={description ?? s.intro}/><meta property="og:type" content="website"/>
    <meta property="og:url" content={pageURL}/><meta property="og:image" content={imageURL}/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:type" content="image/png"/><meta property="og:image:alt" content={title}/>
    <meta name="twitter:card" content="summary_large_image"/>
  </head>
  <body>
    <a class="skip" href="#main">{s.keyboard}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={path(`${lang}/`)}><img src={path('favicon.svg')} width="36" height="36" alt=""/>AI Moe Atlas</a>
        <nav class="site-nav" aria-label={n.nav}>
          {nav.map(item => <a href={path(`${lang}/${item.url}`)} aria-current={section===item.key ? (route===item.url?'page':'location') : undefined}>{item.label}</a>)}
        </nav>
        <nav class="language-switch" aria-label="Language">{locales.map(l => <a href={path(`${l}/${route}`)} lang={htmlLang[l]} hreflang={htmlLang[l]} aria-current={lang===l ? 'true':undefined} class:list={{selected:lang===l}}>{languageNames[l]}</a>)}</nav>
      </div>
    </header>
    <main id="main"><slot/></main>
    <footer class="footer"><p>{s.footer}</p><a href={path(`${lang}/contribute/`)}>{s.contribute}</a><a href={`${repo}/blob/main/RIGHTS.md`}>{s.license} ↗</a><a href={repo}>GitHub ↗</a></footer>
    <script>
      function syncLanguageLinks() {
        const hash = location.hash;
        const anchor = hash && document.getElementById(hash.slice(1));
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.language-switch a')) {
          link.search = location.search;
          link.hash = anchor ? hash : '';
        }
      }
      syncLanguageLinks();
      window.addEventListener('hashchange', syncLanguageLinks);
    </script>
  </body>
</html>
