---
import Layout from '../../layouts/Layout.astro';
import {locales,type Locale} from '../../lib/i18n';
import {resourceText} from '../../lib/resource-text';
import {path} from '../../lib/paths';
import {resources,animations,animationRanks,byPublicationDate,byPublicationTime,directoryCategories,resourceCounts,resourcesUpdatedAt,beijingTime,verificationLabel} from '../../lib/resources';
import registry from '../../../content/resources.json';
import {readPendingAnimationCandidates} from '../../../scripts/lib/resources.mjs';
import {readLikeArchive} from '../../../scripts/lib/like-archive.mjs';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale,s=resourceText[lang];
const ordered=[...animations,...resources.filter(r=>r.category!=='animation').sort(byPublicationDate)];
const recentOrder=new Map([...animations].sort(byPublicationTime).map((r,index)=>[r.id,index]));
const root=new URL('../../../',import.meta.url);
const [pending,archives]=await Promise.all([readPendingAnimationCandidates(registry,root),readLikeArchive(root)]);
const archiveByPath=new Map(archives.map(archive=>[archive.path,archive]));
const pendingArchive=archiveByPath.get(registry.pendingAnimationEvidence?.path);
const refreshFailures=new Map(pendingArchive?.refreshFailures.map(row=>[row.bvid,row]));
---
<Layout lang={lang} title={s.directory} description={s.directoryIntro} active="resources" route="resources/">
  <section class="page-heading"><div><p class="eyebrow">{resourcesUpdatedAt}</p><h1>{s.directory}</h1><p class="lead">{s.directoryIntro} {s.latestIntro}</p></div></section>
  <div class="resource-filters" role="group" aria-label={s.categories}>
    <button class="selected" data-resource-filter="all" aria-pressed="true">{s.all} <span>{resources.length}</span></button>
    {directoryCategories.map(c=><button data-resource-filter={c} aria-pressed="false">{s.category[c].title} <span>{resourceCounts[c]}</span></button>)}
  </div>
  <div class="resource-filters resource-type-filters" id="resource-types" role="group" aria-label={s.videoTypes} hidden>
    <button class="selected" data-resource-type-filter="all" aria-pressed="true">{s.allVideoTypes}</button>
    {Object.entries(s.types).map(([type,label])=><button data-resource-type-filter={type} aria-pressed="false">{label} <span>{animations.filter(r=>r.subtype===type).length}</span></button>)}
  </div>
  <div class="filter-bar">
    <label class="search-field"><input id="resource-search" type="search" placeholder={s.search} aria-label={s.search}/></label>
    <label id="resource-sort-label" class="resource-sort" hidden>{s.sort}
      <select id="resource-sort">
        <option value="likes">{s.sortLikes}</option>
        <option value="recent">{s.sortRecent}</option>
      </select>
    </label>
    <button class="button secondary" id="resource-reset">{s.clear}</button>
  </div>
  <p class="subtle" role="status"><strong id="resource-count">{resources.length}</strong> {s.results}</p>
  {archives.length>0&&<details class="resource-record animation-evidence-panel" id="like-evidence">
    <summary>{s.likeArchive.title} ({archives.length})</summary>
    <p>{s.likeArchive.intro}</p>
    <ul>
      {archives.map(archive=><li data-capture-scope={archive.scope}>
        <a class="text-link" href={path(archive.route)}><time datetime={archive.capturedAt}>{beijingTime.format(new Date(archive.capturedAt))}</time> · JSON</a>
        <span>{archive.scope&&<> · {archive.scope==='selected-catalog-and-candidates'?s.likeArchive.selectedCatalog:s.likeArchive.selective}</>} · {archive.videoCount} {s.category.animation.unit}{archive.pendingCount>0&&<> · {archive.pendingCount} {s.likeArchive.pending}</>}{archive.refreshFailures.length>0&&<> · {s.refreshFailures(archive.refreshFailures.length)}</>}</span>
        <code>SHA-256 {archive.sha256}</code>
      </li>)}
    </ul>
  </details>}
  {pending.length>0&&<details class="resource-record animation-evidence-panel" id="pending-animation-evidence">
    <summary>{s.pendingAnimation.title} (<span id="pending-animation-count">{pending.length}</span>)</summary>
    <p>{s.pendingAnimation.intro}{pendingArchive&&<> <a class="text-link" href={path(pendingArchive.route)}>{s.snapshot}</a></>}</p>
    <ul>
      {pending.map(row=><li data-pending-search={[row.discoveredTitle,row.bvid,row.searchIndex?.publisher].filter(Boolean).join(' ')}>
        <a class="text-link" href={`https://www.bilibili.com/video/${row.bvid}/`} target="_blank" rel="noopener noreferrer">{row.discoveredTitle} ↗</a>
        <p class="resource-byline">{row.bvid} · {row.status==='source-unavailable'?s.pendingAnimation.sourceUnavailable:s.unranked}
          {' · '}{s.pendingAnimation.checked} <time datetime={row.observedAt}>{beijingTime.format(new Date(row.observedAt))}</time>
          {' · '}<a class="text-link" href={row.requestUrl} target="_blank" rel="noopener noreferrer">{s.pendingAnimation.query} ↗</a>
        </p>
        {row.publicPage?.outcome&&<p class="resource-byline" data-pending-public-page={row.publicPage.outcome}>
          {s.pendingAnimation.pageOutcome[row.publicPage.outcome as keyof typeof s.pendingAnimation.pageOutcome]}
          {' · '}<time datetime={row.publicPage.accessedAt}>{beijingTime.format(new Date(row.publicPage.accessedAt))}</time>
        </p>}
        {row.searchIndex&&<p class="resource-byline" data-pending-search-index>
          <a class="text-link" href={row.searchIndex.url} target="_blank" rel="noopener noreferrer">{s.pendingAnimation.searchIndex} ↗</a>
          {' · '}<time datetime={row.searchIndex.observedAt}>{beijingTime.format(new Date(row.searchIndex.observedAt))}</time>
          {row.searchIndex.publisher&&<> · {s.pendingAnimation.searchPublisher}{' '}
            <a class="text-link" data-pending-search-publisher href={row.searchIndex.publisherUrl} target="_blank" rel="noopener noreferrer">{row.searchIndex.publisher}</a>
          </>}
        </p>}
      </li>)}
    </ul>
  </details>}
  <div class="resource-list" id="resource-list">
    {ordered.map(r=>{
      const saved=r.likes?.evidence&&archiveByPath.get(r.likes.evidence.path);
      const latestFailure=r.bvid&&refreshFailures.get(r.bvid);
      return <article class="resource-record" id={r.id} data-resource-category={r.category} data-resource-type={r.subtype} data-recent-order={recentOrder.get(r.id)}
      data-resource-search={[
        r.title.zh,r.title.en,r.title.ja,r.sourceTitle,r.publisher,r.bvid,r.summary.zh,r.summary.en,r.summary.ja,
        r.subtype&&locales.map(locale=>resourceText[locale].types[r.subtype as keyof typeof s.types]).join(' '),
        ...r.relations.map(link=>link.title),
      ].join(' ')}>
      <div class="resource-record-top"><span class="pill">{s.category[r.category].title}</span>{r.subtype&&<span class="resource-subtype">{s.types[r.subtype as keyof typeof s.types]}</span>}</div>
      <h2><a href={r.url} target="_blank" rel="noopener noreferrer">{r.title[lang]} ↗</a></h2>
      <p class="resource-byline">{s.publisher} · {r.publisher} {r.publicationDate&&<> · {s.published} <time datetime={r.publishedAt??r.publicationDate}>{r.publishedAt?beijingTime.format(new Date(r.publishedAt)):r.publicationDate}</time>{r.publishedAt&&<> ({s.publicationZone})</>}</>}{r.bvid&&<> · {r.bvid}</>}</p>
      {r.category==='animation'&&<p class="resource-byline">{r.likes
        ? <><strong>#{animationRanks.get(r.id)} · {r.likes.count.toLocaleString(lang)} {s.likes}</strong> · <time datetime={r.likes.observedAt}>{beijingTime.format(new Date(r.likes.observedAt))}</time>{saved&&<> · <a class="text-link" href={path(saved.route)}>{s.snapshot}</a></>} · <a class="text-link" href={r.likes.sourceUrl} target="_blank" rel="noopener noreferrer">{s.liveLikes} ↗</a></>
        : s.unranked}</p>}
      {latestFailure&&<p class="resource-byline" data-like-refresh-failure>{s.previousLikes} · <time datetime={latestFailure.observedAt}>{beijingTime.format(new Date(latestFailure.observedAt))}</time> · {s.pendingAnimation.sourceUnavailable}</p>}
      <p>{r.summary[lang]}</p>
      <span class:list={['resource-verification',{'partial':r.verification?.result==='partial-response'||r.verification?.result==='blocked'}]}>{verificationLabel(r,lang)}</span>
      <details><summary>{s.more}</summary>
        {r.sourceTitle&&<p>{s.originals} · {r.sourceTitle}</p>}
        <p>{r.verification?.result==='index-verified'?s.indexScope:r.verification?s.scope:s.inherited}</p>
        {r.addedAt&&<p>{s.added} · <time datetime={r.addedAt}>{r.addedAt}</time></p>}
        <h3>{s.rights}</h3><p>{r.rights[lang]}</p>
        {r.relations.length>0&&<><h3>{s.relations}</h3><ul>{r.relations.map(link=><li><a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.title} ↗</a></li>)}</ul></>}
      </details>
      <a class="text-link resource-original" href={r.url} target="_blank" rel="noopener noreferrer">{s.visit} ↗</a>
    </article>})}
  </div>
  <p class="empty-state" id="resource-empty" hidden>{s.empty}</p>
</Layout>
<style>
  .resource-type-filters{margin-top:12px}
  .resource-sort{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px}
  .animation-evidence-panel{margin-block:12px;scroll-margin-top:22px}
  .animation-evidence-panel summary{cursor:pointer;font-weight:600}
  .animation-evidence-panel ul{padding-inline-start:1.35em}
  #like-evidence li+li{margin-top:10px}
  #like-evidence code{display:block;overflow-wrap:anywhere;font-size:.78em;color:var(--muted)}
</style>
<script>import '../../scripts/resources';</script>
