---
import Layout from '../../layouts/Layout.astro';
import DirectorySearch from '../../components/DirectorySearch.astro';
import { locales, type Locale } from '../../lib/i18n';
import { directoryIndex } from '../../lib/directory';
import { categories, categoryURL } from '../../lib/resources';
import { resourceText } from '../../lib/resource-text';
import { navigation } from '../../lib/navigation';
import { path } from '../../lib/paths';
export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const n = navigation[lang], rs = resourceText[lang];
const url = path(`${lang}/collection/`);
const rows = directoryIndex(lang);
const pageSize = 30;
---
<Layout lang={lang} title={n.directory} description={n.intro} active="resources" route="collection/">
  <header class="directory-heading"><h1>{n.directory}</h1><DirectorySearch lang={lang}/></header>
  <div class="directory-layout">
    <nav class="directory-sidebar" aria-label={rs.categories}>
      <a data-scope="" href={url} aria-current="true">{n.allResources}</a>
      {categories.map(key => <a data-scope={key} href={categoryURL(key, lang)} aria-label={rs.category[key].title}>
        <span class="scope-full">{rs.category[key].title}</span><span class="scope-short">{n.shortCategory[key]}</span>
      </a>)}
    </nav>
    <section id="directory-results" aria-labelledby="directory-title" data-index={url+'index.json'}
      data-page-size={pageSize} data-total={rows.length} data-units={rs.results} data-empty={rs.empty} data-loading={n.loading} data-failure={n.failure}>
      <div class="directory-panel-heading">
        <h2 id="directory-title">{n.allResources}</h2>
        <a id="directory-category-page" hidden>{n.openCategory} →</a>
      </div>
      <div class="directory-summary">
        <p role="status">{rows.length} {rs.results}</p>
        <a id="directory-clear" href={url} hidden>{rs.clear}</a>
      </div>
      <ul class="directory-list">
        {rows.slice(0, pageSize).map(row => <li>
          <div><a href={row.href}>{row.title}</a><small>{[rs.category[row.categories[0]].title, row.by].filter(Boolean).join(' · ')}</small></div>
          <a href={row.action.href} download={row.action.download}>{row.action.label}</a>
        </li>)}
      </ul>
      <button id="directory-more" class="button secondary" hidden>{n.more}</button>
      <button id="directory-retry" class="button secondary" hidden>{n.retry}</button>
    </section>
  </div>
</Layout>
<script>
  import '../../scripts/directory';
</script>
