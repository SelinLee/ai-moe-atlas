---
import Layout from '../../layouts/Layout.astro';import {locales,t,type Locale} from '../../lib/i18n';import {repo} from '../../lib/paths';import leads from '../../../content/leads.json';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Locale,s=t(lang);
const stages={zh:[['搜索已有形象','在 B 站、作者主页、作品站和 GitHub 搜索。将结果放入待核验清单，绝不自动变成已收录角色。'],['追溯原始来源','分别记录角色原作者、二创作者、视频 UP 主和素材发布者；保留 BV 号、动态链接及跳转后的原始地址。'],['核验图片使用条件','查看图片专属许可及作者声明。软件许可证、播放量、转载标记均不能替代美术授权。'],['保存原图与证据','保留原始字节、尺寸、SHA-256、采集日期、授权依据；GitHub 文件固定到具体提交。'],['高清化与规范化','优先寻找作者高清原图。只做忠于原图的缩放、画布和格式处理；插值放大不标为细节恢复。'],['带来源打包','输出原图、规范化素材、加工记录、署名与许可。人工审核后合并发布。']],en:[['Find existing artwork','Search Bilibili, creator profiles, art sites, and GitHub. Results enter a review queue, never the published catalog automatically.'],['Trace the original','Distinguish character designers, derivative artists, video uploaders, and asset publishers. Preserve video IDs and original post URLs.'],['Check image-specific terms','Read artwork licenses and creator statements. Software licenses and popularity do not establish image permissions.'],['Retain originals and evidence','Preserve original bytes, dimensions, SHA-256, collection date, and permission evidence. Pin GitHub files to a commit.'],['Normalize without redesign','Prefer a creator’s high-resolution original. Resize and convert faithfully. Interpolation is never labeled recovered detail.'],['Package with provenance','Ship originals, normalized assets, processing records, attribution, and terms. Publish only after review.']],ja:[['既存作品を探す','Bilibili、作者ページ、作品サイト、GitHub を検索。結果は確認待ち一覧へ入れ、自動公開しません。'],['原典をたどる','キャラクター原作者、二次創作者、動画投稿者、素材配布者を区別。動画 ID と元の投稿 URL を保存します。'],['画像の利用条件を確認','美術の許諾と作者の声明を確認。ソフトウェアのライセンスや人気だけでは画像の許可になりません。'],['原本と証拠を保存','原本、寸法、SHA-256、収集日時、利用条件の根拠を保存。GitHub のファイルはコミットに固定します。'],['再デザインせず規格統一','作者の高解像度原図を優先。原図に忠実なリサイズと形式変換のみ実施。補間拡大を細部復元とは呼びません。'],['出典とともに配布','原図、規格統一版、加工記録、クレジット、利用条件を同梱。確認後に公開します。']]};
---
<Layout lang={lang} title={s.collectionFlow} description={s.flowIntro} active="collectionFlow" route="collection/"><section class="page-heading"><div><p class="eyebrow">SOURCE FIRST. ALWAYS.</p><h1>{s.flowTitle}</h1><p class="lead">{s.flowIntro}</p></div></section><div class="steps-grid">{stages[lang].map(([title,text],i)=><section class="panel"><span class="step-number">0{i+1}</span><h2>{title}</h2><p>{text}</p></section>)}</div><section style="margin-top:36px"><div class="section-title"><div><h2>{s.videoSource}</h2><p>Bilibili · 蓝色大肥鱼 · 2026-09-28</p></div></div><p class="subtle">{s.discoveryOnly}</p><div class="lead-list">{leads.map(l=><article class="lead-item"><div><h3>{l.title}</h3><p>{l.creator} · {l.note[lang]}</p></div><a href={l.url} target="_blank" rel="noopener noreferrer">{s.viewSource} ↗</a></article>)}</div><a class="button secondary" href={`${repo}/blob/main/docs/COLLECTION.${lang}.md`}>{s.guide} ↗</a></section></Layout>
