---
import Layout from '../../layouts/Layout.astro';import {locales,t,type Locale} from '../../lib/i18n';import {repo,path} from '../../lib/paths';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}const lang=Astro.params.lang as Locale,s=t(lang);const guide=lang==='zh'?'CONTRIBUTING.md':`docs/CONTRIBUTING.${lang}.md`;
---
<Layout lang={lang} title={s.contribute} description={s.contributeIntro} active="contribute" route="contribute/"><section class="page-heading"><div><p class="eyebrow">BUILT BY THE COMMUNITY</p><h1>{s.contributeTitle}</h1><p class="lead">{s.contributeIntro}</p></div></section><div class="button-row"><a class="button" href={`${repo}/issues/new?template=source.yml`} target="_blank" rel="noopener noreferrer">{s.submit} ↗</a><a class="button secondary" href={`${repo}/blob/main/${guide}`} target="_blank" rel="noopener noreferrer">{s.guide}</a></div><div class="steps-grid" style="margin-top:30px">{[1,2,3,4].map(n=><article class="panel"><span class="step-number">0{n}</span><h2>{s[`step${n}` as keyof typeof s]}</h2><p>{s[`step${n}Text` as keyof typeof s]}</p></article>)}</div><section class="panel" style="margin-top:24px"><h2>{s.policy}</h2><p>{s.policyText}</p><h3>{s.scope}</h3><p>{s.scopeText}</p><div class="file-links"><a href={path(`${lang}/collection/`)}>{s.collectionFlow} →</a><a href={`${repo}/issues/new?template=correction.yml`} target="_blank" rel="noopener noreferrer">{s.correct} ↗</a></div></section></Layout>
