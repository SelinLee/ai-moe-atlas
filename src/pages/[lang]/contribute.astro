---
import Layout from '../../layouts/Layout.astro';
import { locales, t, type Locale } from '../../lib/i18n';
import { repo, path } from '../../lib/paths';
import { characters, entities } from '../../lib/data';
import { usePurposes } from '../../lib/contribution.mjs';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang = Astro.params.lang as Locale, s = t(lang);
const guide = lang === 'zh' ? 'CONTRIBUTING.md' : `docs/CONTRIBUTING.${lang}.md`;
const absolute = (route: string) => new URL(path(route), Astro.site).href;
const config = { lang, purposes: usePurposes, openingLead: s.openingLead, openingCorrection: s.openingCorrection, openingRights: s.openingRights, fillRequired: s.fillRequired };
---
<Layout lang={lang} title={s.contribute} description={s.contributeIntro} active="contribute" route="contribute/">
  <section class="page-heading"><div><p class="eyebrow">BUILT BY THE COMMUNITY</p><h1>{s.contributeTitle}</h1><p class="lead">{s.contributeIntro}</p></div></section>

  <div id="contribute-forms" data-config={JSON.stringify(config)}>
  <section class="panel" aria-labelledby="lead-title">
    <h2 id="lead-title">{s.contributeLead}</h2>
    <p>{s.contributeLeadIntro}</p>
    <form id="lead-form" class="lead-form" novalidate>
      <div class="form-group">
        <label for="lead-source">{s.leadSource}</label>
        <input id="lead-source" name="source" type="url" required maxlength="2048" placeholder="https://…" autocomplete="off"/>
        <p class="subtle">{s.step1Text}</p>
      </div>
      <div class="form-group">
        <label for="lead-ai">{s.leadAi}</label>
        <select id="lead-ai" name="ai" required>
          <option value="">{s.allModels}</option>
          {entities.map(e=><option value={e.name}>{e.name}</option>)}
        </select>
      </div>
      <details id="lead-known">
        <summary>{s.leadKnown}</summary>
        <div class="studio-advanced">
          <div class="form-group">
            <label for="lead-creator">{s.leadCreator}</label>
            <input id="lead-creator" name="creator" type="text" maxlength="80" autocomplete="off"/>
            <p class="subtle">{s.leadUnknown}</p>
          </div>
          <div class="form-group">
            <label for="lead-chain">{s.sourceChain}</label>
            <textarea id="lead-chain" name="chain" rows="3" maxlength="400"></textarea>
          </div>
          <div class="form-group">
            <label for="lead-rights">{s.license}</label>
            <textarea id="lead-rights" name="rights" rows="3" maxlength="400"></textarea>
          </div>
          <div class="form-group">
            <label for="lead-notes">{s.assets}</label>
            <textarea id="lead-notes" name="notes" rows="3" maxlength="400"></textarea>
          </div>
        </div>
      </details>
      <div class="button-row">
        <button class="button" type="submit">{s.leadOpen} ↗</button>
        <a class="button secondary" href={path(`${lang}/collection/`)}>{s.collectionFlow} →</a>
      </div>
      <p class="status" id="lead-status" role="status" aria-live="polite"></p>
      <p class="subtle">{s.noAuto}</p>
      <p class="notice"><strong>{s.needAccount}</strong> {s.needAccountNote}</p>
      <p class="subtle">{s.privacyNote}</p>
    </form>
  </section>

  <div class="steps-grid" style="margin-top:30px">{[1,2,3,4].map(n=><article class="panel"><span class="step-number">0{n}</span><h2>{s[`step${n}` as keyof typeof s]}</h2><p>{s[`step${n}Text` as keyof typeof s]}</p></article>)}</div>

  <section class="panel" aria-labelledby="correct-title" style="margin-top:24px">
    <h2 id="correct-title">{s.correctTitle}</h2>
    <p>{s.correctIntro}</p>
    <form id="correction-form" class="lead-form" novalidate>
      <div class="form-group">
        <label for="correction-entry">{s.correctEntry}</label>
        <select id="correction-entry" name="entry" required>
          <option value="">{s.all}</option>
          {characters.map(c=><option value={absolute(`${lang}/characters/${c.id}/`)}>{c.name[lang]}</option>)}
        </select>
      </div>
      <div class="form-group">
        <label for="correction-details">{s.correctRequest}</label>
        <textarea id="correction-details" name="details" rows="4" maxlength="800" required></textarea>
      </div>
      <div class="button-row"><button class="button secondary" type="submit">{s.correctSubmit} ↗</button></div>
      <p class="status" id="correction-status" role="status" aria-live="polite"></p>
      <p class="subtle">{s.privacyNote}</p>
    </form>
  </section>

  <section class="panel" aria-labelledby="rights-title" style="margin-top:24px">
    <h2 id="rights-title">{s.rightsConfirmTitle}</h2>
    <p>{s.rightsConfirmIntro}</p>
    <form id="rights-form" class="lead-form" novalidate>
      <div class="form-group">
        <label for="rights-entry">{s.correctEntry}</label>
        <select id="rights-entry" name="entry" required>
          <option value="">{s.all}</option>
          {characters.map(c=><option value={absolute(`${lang}/characters/${c.id}/`)}>{c.name[lang]}</option>)}
        </select>
      </div>
      <div class="form-group">
        <label for="rights-role">{s.rightsRole}</label>
        <select id="rights-role" name="role" required>
          <option value="">{s.rightsRole}</option>
          <option value="creator">{s.roleCreator}</option>
          <option value="representative">{s.roleRepresentative}</option>
          <option value="user">{s.roleUser}</option>
        </select>
      </div>
      <fieldset class="form-group">
        <legend>{s.rightsScope}</legend>
        <div class="studio-check-list">{config.purposes.map(p=><label class="studio-check"><input type="checkbox" name="scope" value={p}/>{s[`use${p[0].toUpperCase()}${p.slice(1).replace(/-(\w)/g,(_m,c)=>c.toUpperCase())}` as keyof typeof s]}</label>)}</div>
        <p class="subtle">{s.rightsScopeHint}</p>
      </fieldset>
      <div class="form-group">
        <label for="rights-decision">{s.rightsDecision}</label>
        <select id="rights-decision" name="decision" required>
          <option value="">{s.rightsDecision}</option>
          <option value="allowed">{s.decisionAllow}</option>
          <option value="prohibited">{s.decisionDeny}</option>
          <option value="unconfirmed">{s.decisionUnsure}</option>
        </select>
      </div>
      <div class="form-group">
        <label for="rights-evidence">{s.rightsEvidence}</label>
        <textarea id="rights-evidence" name="evidence" rows="3" maxlength="600" required></textarea>
      </div>
      <div class="form-group">
        <label for="rights-contact">{s.rightsContact}</label>
        <input id="rights-contact" name="contact" type="url" maxlength="2048" placeholder="https://…" autocomplete="off"/>
      </div>
      <div class="button-row"><button class="button secondary" type="submit">{s.rightsSubmit} ↗</button></div>
      <p class="status" id="rights-status" role="status" aria-live="polite"></p>
      <p class="subtle">{s.rightsNoAuto}</p>
    </form>
  </section>

  <section class="panel" style="margin-top:24px">
    <h2>{s.policy}</h2>
    <p>{s.policyText}</p>
    <h3>{s.scope}</h3>
    <p>{s.scopeText}</p>
    <div class="file-links">
      <a href={`${repo}/blob/main/${guide}`} target="_blank" rel="noopener noreferrer">{s.guide} ↗</a>
      <a href={path(`${lang}/collection/`)}>{s.collectionFlow} →</a>
    </div>
  </section>
  </div>
</Layout>
<script>
  import { collectFields, forms, issueURL } from '../../lib/contribution.mjs';
  const config = JSON.parse(document.querySelector<HTMLElement>('#contribute-forms')!.dataset.config!) as { openingLead: string; openingCorrection: string; openingRights: string; fillRequired: string };
  const setup = [
    { id: 'lead', form: 'lead', message: config.openingLead },
    { id: 'correction', form: 'correction', message: config.openingCorrection },
    { id: 'rights', form: 'rights', message: config.openingRights },
  ] as const;
  for (const { id, form, message } of setup) {
    const element = document.querySelector<HTMLFormElement>(`#${id}-form`)!;
    const status = document.querySelector<HTMLElement>(`#${id}-status`)!;
    element.addEventListener('submit', e => {
      e.preventDefault();
      const values: Record<string, string> = {};
      for (const [key, value] of new FormData(element)) {
        values[key] = values[key] ? `${values[key]}, ${String(value)}` : String(value);
      }
      const missing = forms[form].required.find(name => !(values[name] ?? '').trim());
      if (missing) { status.textContent = config.fillRequired; (element.elements.namedItem(missing) as HTMLElement | null)?.focus(); return; }
      status.textContent = message;
      // Only the whitelisted fields of this template are carried over.
      window.open(issueURL(forms[form].template, collectFields(form, values)), '_blank', 'noopener,noreferrer');
    });
  }
</script>
