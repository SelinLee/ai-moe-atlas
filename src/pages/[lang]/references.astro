---
import Layout from '../../layouts/Layout.astro';
import {locales,type Locale} from '../../lib/i18n';
import {referenceCollection as collection,referenceText} from '../../lib/references';
import {path} from '../../lib/paths';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale,s=referenceText[lang];
---
<Layout lang={lang} title={s.archive} description={collection.description[lang]} route="references/">
 <a class="back-link" href={path(`${lang}/#identities`)}>← {s.back}</a>
 <section class="page-heading"><div><p class="eyebrow">{s.badge}</p><h1>{s.archive}</h1><p class="lead">{collection.description[lang]}</p><p class="lead">{collection.notice[lang]}</p></div></section>
 <section class="panel"><h2>{s.history}</h2><p>{s.dates} · {collection.generator}</p><p>{s.detail}</p><p>{s.terms}</p><div class="file-links"><a href={path('generated/ai-models-v5/manifest.json')}>{s.manifest}</a><a href={path('generated/ai-models-v5/upstream-registry.json')}>{s.record}</a></div></section>
 <div class="reference-archive">{collection.assets.map(a=><article id={a.id} class="panel reference-record" data-reference-record={a.id}>
  <a href={path(a.original.path)}><img src={path(a.preview.path)} alt={`${a.name[lang]} · ${s.variants} · ${s.badge}`} width={a.original.width} height={a.original.height} loading="lazy"/></a>
  <div><span class="identity-badge">{s.badge}</span><h2>{a.name[lang]}</h2><p>{a.features[lang]}</p><p>{s.credit}：{a.attribution.map((author,i)=><>{i>0?' → ':''}<a class="text-link" href={author.url}>{author.name}</a></>)}</p>
  <div class="file-links"><a href={path(`${lang}/characters/${a.characterId}/`)}>{s.entry}</a><a href={a.sourceVideo} target="_blank" rel="noopener noreferrer">{s.source} · {a.sourceVideoPublisher}</a><a href={a.attribution[a.attribution.length-1].publication} target="_blank" rel="noopener noreferrer">{s.upstream}</a><a href={a.rights.licenseUrl}>{a.rights.license??s.upstream}</a><a href={path(a.original.path)}>{s.file} · {a.original.width} × {a.original.height}</a></div>
  <details><summary>{s.evidence}</summary><p>SHA-256</p><code class="reference-hash">{a.original.sha256}</code><p>{s.dates}</p><p>{a.sourceVideo}</p></details>
  <details><summary>{s.prompt}</summary><pre class="reference-prompt" lang="en">{a.prompt}</pre></details></div>
 </article>)}</div>
</Layout>
