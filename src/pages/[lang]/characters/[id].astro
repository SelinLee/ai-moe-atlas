---
import { readFile } from 'node:fs/promises';
import Layout from '../../../layouts/Layout.astro';
import ExpressionGrid from '../../../components/ExpressionGrid.astro';
import Icon from '../../../components/Icon.astro';
import { locales,t,type Locale } from '../../../lib/i18n';
import { characters,entityName } from '../../../lib/data';
import { path } from '../../../lib/paths';
import { baselineText } from '../../../lib/baselines';
export function getStaticPaths(){return locales.flatMap(lang=>characters.map(character=>({params:{lang,id:character.id},props:{character}})));}
const lang=Astro.params.lang as Locale,s=t(lang),c=Astro.props.character;
const b=baselineText[lang];
const manifest=c.downloadable?JSON.parse(await readFile(`public/collected/${c.id}/manifest.json`,'utf8')):null;
const credit=c.attribution.map(a=>`${a.name} — ${a.url}`).join('\n')+`\n${c.source}\n${c.license}`;
const roles={zh:{'original-character':'原角色作者','secondary-design':'二创设计','published-adaptation':'素材发布与加工',publisher:'发布者'},en:{'original-character':'Original character creator','secondary-design':'Derivative designer','published-adaptation':'Asset publisher / adapter',publisher:'Publisher'},ja:{'original-character':'キャラクター原作者','secondary-design':'二次デザイン','published-adaptation':'素材公開・加工',publisher:'公開者'}}[lang];
---
<Layout lang={lang} title={c.name[lang]} description={c.description[lang]} route={`characters/${c.id}/`}>
 <a class="back-link" href={path(`${lang}/`)}>← {s.back}</a>
 <section class="detail-hero"><div class="detail-art" style={`--card-bg:${c.bg}`}>
 {c.preview?<img src={path(c.preview)} alt={c.name[lang]} width="512" height="512"/>:<div class="source-art"><Icon name="book" size={48}/><strong>{entityName(c.entity)}</strong><span>{c.author}</span><p class="subtle">{s.sourceOnly}</p></div>}
 </div><div class="detail-info"><p class="eyebrow">{c.downloadable?'COLLECTED & CREDITED':'SOURCE ARCHIVE'}</p><h1>{c.name[lang]}</h1><div style="margin-top:16px"><span class="pill">{entityName(c.entity)}</span><span class="pill">{s.unofficial}</span><span class="pill">{s[c.style as 'anime'|'pixel']}</span></div><p class="description">{c.description[lang]}</p><dl class="metadata"><dt>{s.author}</dt><dd><a class="text-link" href={c.authorUrl} target="_blank" rel="noopener noreferrer">{c.author} ↗</a></dd><dt>{s.license}</dt><dd>{c.downloadable?('licenseLabel' in c?c.licenseLabel[lang]:c.license):s.sourceOnly}</dd><dt>{s.checked}</dt><dd>{c.verifiedAt}</dd></dl><div class="button-row">{c.downloadable&&<a class="button" download href={path(`packs/${c.id}.zip`)}><Icon name="download" size={17}/>{s.pack}</a>}<a class="button secondary" href={c.source} target="_blank" rel="noopener noreferrer">{s.viewSource}<Icon name="external" size={15}/></a></div><p class="subtle">{c.downloadable?s.noncommercial:s.noMirror}</p></div></section>
 <div class="detail-columns"><section class="panel"><h2>{s.about}</h2><p>{c.story[lang]}</p><h3>{s.features}</h3><p>{c.features[lang]}</p><h3>{s.changes}</h3><p>{c.downloadable?s.changesText:s.referenceNote}</p></section><section class="panel"><h2>{s.sourceChain}</h2><ol class="source-chain">{c.attribution.map(a=><li><small>{roles[a.role as keyof typeof roles]}</small><a href={a.url} target="_blank" rel="noopener noreferrer">{a.name} ↗</a>{'publication' in a&&a.publication&&<small><a href={a.publication} target="_blank" rel="noopener noreferrer">{s.upstream}</a></small>}</li>)}</ol><p>{c.provenanceNote[lang]}</p><div class="file-links"><a href={c.originalPublication} target="_blank" rel="noopener noreferrer">{s.upstream} ↗</a><a href={c.licenseUrl} target="_blank" rel="noopener noreferrer">{s.license} ↗</a></div></section></div>
 {'observations' in c&&c.observations&&<section class="panel observation-panel"><h2>{b.evidence}</h2><p>{b.evidenceNote}</p><ul class="source-chain">{c.observations.map(o=><li><a href={o.url} target="_blank" rel="noopener noreferrer">{o.title} ↗</a><small>{o.publisher} · {o.reviewedAt}</small></li>)}</ul></section>}
 {c.downloadable&&<><section class="detail-assets"><div class="section-title"><h2>{s.assets}</h2><span class="license-badge">{s.noncommercial}</span></div><ExpressionGrid character={c} lang={lang}/></section><section class="panel"><h2>{s.provenance}</h2><p>{manifest.source.rights.terms?.[lang]??s.rightsText}</p><div class="file-links"><a download href={path(`collected/${c.id}/manifest.json`)}>{s.manifest}</a><a download href={path(`collected/${c.id}/source.json`)}>{s.sources}</a></div>{manifest.source.originals.map(o=><div class="lead-item" style="margin-top:14px"><div><h3>{o.label[lang]}</h3><p>{s.native}: {o.width} × {o.height} · SHA-256: <code>{o.sha256.slice(0,16)}…</code></p></div><a download href={path(o.localPath)}>{s.originalFile} ↓</a><a download href={path(`collected/${c.id}/${o.id}/large-1024.png`)}>{s.large} ↓</a></div>)}<p class="subtle" style="margin:14px 0">{s.upscaleNote}</p><h3>{s.attribution}</h3><pre class="copy-credit" id="credit">{credit}</pre><button class="button secondary" id="copy-credit" data-done={s.copied} data-failed={s.copyFailed}>{s.copy}</button><span id="copy-status" class="status" role="status"></span></section></>}
</Layout>
<script>
 document.querySelector<HTMLButtonElement>('#copy-credit')?.addEventListener('click',async e=>{const button=e.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText(document.querySelector('#credit')!.textContent!);document.querySelector('#copy-status')!.textContent=button.dataset.done!;}catch{document.querySelector('#copy-status')!.textContent=button.dataset.failed!;}});
</script>
