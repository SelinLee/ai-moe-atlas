---
import Layout from '../../layouts/Layout.astro';
import {locales,type Locale} from '../../lib/i18n';
import {chibiCollection as collection,chibiText} from '../../lib/chibi';
import {path} from '../../lib/paths';
import {readFile} from 'node:fs/promises';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale,s=chibiText[lang];
const prompts=await Promise.all(collection.assets.map(a=>readFile(`public/${a.prompt.path}`,'utf8')));
---
<Layout lang={lang} title={s.archive} description={collection.description[lang]} route="chibi/">
 <a class="back-link" href={path(`${lang}/#chibi`)}>← {s.back}</a>
 <section class="page-heading"><div><p class="eyebrow">{s.eyebrow}</p><h1>{s.archive}</h1><p class="lead">{collection.description[lang]}</p><p class="identity-notice">{collection.notice[lang]}</p></div></section>
 <section class="panel"><h2>{s.details}</h2><p>{s.detail}</p><p>{s.rights}</p><div class="file-links"><a href={path('generated/super-chibi-v1/manifest.json')}>{s.record}</a><a href={path(`${lang}/references/`)}>{s.legacy}</a></div></section>
 <div class="reference-archive">{collection.assets.map((a,i)=><article id={a.id} class="panel reference-record" data-chibi-record={a.id}>
  <a href={path(a.original.path)} aria-label={`${a.name[lang]} · ${s.full}`}><img src={path(a.preview.path)} alt={`${a.name[lang]} · ${s.views} · ${s.badge}`} width={a.preview.width} height={a.preview.height} loading="lazy"/></a>
  <div><span class="identity-badge">{s.badge} · V{a.revision}</span><h2>{a.name[lang]}</h2><p>{a.features[lang]}</p><p>{s.credit}：{a.attribution.length?a.attribution.map((author,i)=><>{i>0?' → ':''}<a class="text-link" href={author.url}>{author.name}</a></>):s.unknown}</p>
  <div class="file-links"><a href={a.sourceVideo} target="_blank" rel="noopener noreferrer">{s.source}{a.sourceVideoPublisher&&` · ${a.sourceVideoPublisher}`}</a>{a.rights.license&&<a href={a.rights.licenseUrl!}>{a.rights.license}</a>}<a href={path(a.original.path)}>{s.full} · {a.original.width} × {a.original.height}</a></div>
  <details><summary>{s.record}</summary><p>{s.imported}：{a.importedAt} · {a.generator}</p><p>SHA-256</p><code class="reference-hash">{a.original.sha256}</code><div class="file-links"><a href={path(a.request.path)}>JSON</a><a href={path(a.prompt.path)}>{s.prompt}</a></div></details>
  <details><summary>{s.prompt}</summary><pre class="reference-prompt" lang="en">{prompts[i]}</pre></details></div>
 </article>)}</div>
</Layout>
