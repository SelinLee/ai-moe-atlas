---
import Layout from '../../layouts/Layout.astro';
import { locales, type Locale } from '../../lib/i18n';
import { path } from '../../lib/paths';
import { resourceText } from '../../lib/resource-text';
import { resources } from '../../lib/resources';
import songs from '../../../content/songs.json';

export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }

const lang = Astro.params.lang as Locale;
const labels = resourceText[lang].songs;
const title = resourceText[lang].category.songs.title;
const records = new Map(resources.map(record => [record.id, record]));
---
<Layout lang={lang} title={title} description={labels.intro} active="resources" route="songs/">
  <section class="page-heading">
    <div>
      <p class="eyebrow">AI MOE ATLAS</p>
      <h1>{title}</h1>
      <p class="lead">{labels.intro}</p>
    </div>
    <a class="button secondary heading-action" href={path(`${lang}/resources/?category=animation`)}>{labels.animation} ↗</a>
  </section>

  <nav class="song-jumps" aria-label={title}>
    {songs.map(song => <a href={`#${song.id}`}>{song.title[lang]}</a>)}
  </nav>

  <div class="resource-list song-list">
    {songs.map(song => <article class="resource-record" id={song.id} data-song>
      {song.image && <figure>
        <img src={path(song.image.path)} alt={`${song.title[lang]} · ${labels[song.image.kind as 'characterReference' | 'productionArt']}`} width="96" height="96" loading="lazy"/>
        <figcaption>{labels[song.image.kind as 'characterReference' | 'productionArt']} · <a class="text-link" href={song.image.source}>{song.image.credit}</a></figcaption>
      </figure>}
      <h2>{song.title[lang]}</h2>
      <p><a class="text-link" href={song.original.url} data-song-original>{labels.original} ↗</a> · {song.original.credit}</p>
      <h3>{labels.versions}</h3>
      <ul>
        {song.versions.map(version => {
          const record = records.get(version.id)!;
          return <li>
            <span class="pill">{labels.types[version.type as keyof typeof labels.types]}</span>
            <a class="text-link" href={record.url} data-song-version={record.id}>{record.title[lang]} ↗</a>
            <small>{record.publisher}</small>
          </li>;
        })}
      </ul>
    </article>)}
  </div>
</Layout>
<style>
  .song-jumps{display:flex;flex-wrap:wrap;gap:8px}
  .song-jumps a{padding:6px 11px;border:1px solid var(--border);border-radius:8px;background:white;color:var(--green);font-size:13px;overflow-wrap:anywhere}
  .song-list h2{margin-top:0}
  .song-list h3{margin-top:14px;font-size:13px}
  .song-list figure{float:right;width:108px;margin:0 0 10px 14px;text-align:center}
  .song-list img{width:96px;height:96px;object-fit:contain}
  .song-list figcaption,.song-list small{display:block;color:var(--muted);font-size:11px;overflow-wrap:anywhere}
  .song-list ul{clear:both;list-style:none;padding:0;margin:10px 0 0}
  .song-list li{padding:7px 0;border-top:1px solid var(--border);font-size:13px;overflow-wrap:anywhere}
  .song-list .pill{display:inline-block;margin-inline-end:6px}
</style>
