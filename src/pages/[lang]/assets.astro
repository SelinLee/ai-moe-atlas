---
import { readFile } from 'node:fs/promises';
import Layout from '../../layouts/Layout.astro';
import { navigation } from '../../lib/navigation';
import ExpressionGrid from '../../components/ExpressionGrid.astro';
import Icon from '../../components/Icon.astro';
import { locales, t, type Locale } from '../../lib/i18n';
import { collected } from '../../lib/data';
import { path } from '../../lib/paths';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale,s=t(lang);
const packs=await Promise.all(collected.map(async character=>{
 const source=JSON.parse(await readFile(`public/collected/${character.id}/source.json`,'utf8'));
 return {character,noncommercial:source.rights.commercial!==true};
}));
---
<Layout lang={lang} title={s.assets} description={s.assetIntro} active="assets" route="assets/">
 <section class="page-heading"><div><h1>{navigation[lang].downloads}</h1><p class="lead">{s.assetIntro}</p></div></section>
 <p class="notice">{s.originNote}</p>
 <details class="pack-jumps"><summary>{navigation[lang].packs} ({packs.length})</summary><ul>{packs.map(({character:c})=><li><a href={`#${c.id}`}>{c.name[lang]}</a></li>)}</ul></details>
 {packs.map(({character:c,noncommercial})=><section class="asset-section" id={c.id}><div class="section-title"><div class="asset-intro"><img src={path(c.preview!)} alt="" width="76" height="76"/><div><h2><a href={path(`${lang}/characters/${c.id}/`)}>{c.name[lang]}</a></h2><p>{c.assets.length} {s.assetUnit} · {'licenseLabel' in c?c.licenseLabel[lang]:c.license}</p></div></div><a class="button" download href={path(`packs/${c.id}.zip`)}><Icon name="download" size={17}/>{s.pack}</a></div><ExpressionGrid character={c} lang={lang}/><div class="file-links"><a href={path(`${lang}/characters/${c.id}/`)}>{s.provenance}</a><a download href={path(`collected/${c.id}/manifest.json`)}>{s.manifest}</a><a href={c.source} target="_blank" rel="noopener noreferrer">{s.viewSource} ↗</a></div><p class="subtle" style="margin-top:14px">{noncommercial&&<>{s.noncommercial} · </>}{s.packContains}</p></section>)}
</Layout>
