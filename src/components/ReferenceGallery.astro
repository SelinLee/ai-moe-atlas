---
import { referenceCollection as collection, referenceText } from '../lib/references';
import { path } from '../lib/paths';
import type { Locale } from '../lib/i18n';
const { lang } = Astro.props as {lang:Locale};
const s=referenceText[lang];
---
<section id="identities" class="identity-section" aria-labelledby="identity-title">
 <div class="section-title"><h2 id="identity-title">{collection.title[lang]}</h2><a class="text-link" href={path(`${lang}/references/`)}>{s.archive} ↗</a></div>
 <p class="subtle">{collection.description[lang]}</p>
 <div class="identity-grid">{collection.assets.map((a,i)=><article class="identity-card" data-reference={a.id}>
  <a class="identity-art" href={path(`${lang}/references/#${a.id}`)}><img src={path(a.preview.path)} alt={`${a.name[lang]} · ${s.variants} · ${s.badge}`} width={a.original.width} height={a.original.height} loading={i<3?'eager':'lazy'}/></a>
  <div class="identity-caption"><h3><a href={path(`${lang}/references/#${a.id}`)}>{a.name[lang]}</a></h3><span class="identity-badge">{s.badge}</span><p>{a.features[lang]}</p><p class="identity-credit">{s.credit}：{a.attribution.map((author,i)=><>{i>0?' → ':''}<a class="text-link" href={author.url} target="_blank" rel="noopener noreferrer">{author.name}</a></>)}</p></div>
 </article>)}</div>
 <p class="identity-notice">{collection.notice[lang]}</p>
</section>
