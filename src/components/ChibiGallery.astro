---
import { chibiCollection as collection, chibiText } from '../lib/chibi';
import { path } from '../lib/paths';
import type { Locale } from '../lib/i18n';
const { lang } = Astro.props as {lang:Locale};
const s=chibiText[lang];
---
<section id="chibi" class="chibi-section" aria-label={s.gallery}>
 <div class="chibi-toolbar"><span>{s.views}</span><a class="text-link" href={path(`${lang}/chibi/`)}>{s.archive} ↗</a></div>
 <div class="chibi-grid">{collection.assets.map((a,i)=><article class="chibi-card" data-chibi={a.id}>
  <a class="chibi-art" href={path(`${lang}/chibi/#${a.id}`)} aria-label={`${a.name[lang]} · ${s.full}`}><img src={path(a.preview.path)} alt={`${a.name[lang]} · ${s.views} · ${s.badge}`} width={a.preview.width} height={a.preview.height} loading={i<2?'eager':'lazy'} fetchpriority={i===0?'high':'auto'}/></a>
  <div class="chibi-caption"><div><h2><a href={path(`${lang}/chibi/#${a.id}`)}>{a.name[lang]}</a></h2><span class="identity-badge">{s.badge} · V{a.revision}</span></div><a class="text-link" href={path(`${lang}/chibi/#${a.id}`)}>{s.full} ↗</a></div>
 </article>)}</div>
 <p class="identity-notice">{collection.attributionNote[lang]}</p>
 <p class="identity-notice">{collection.notice[lang]}</p>
</section>
